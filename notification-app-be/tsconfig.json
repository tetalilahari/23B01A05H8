{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "../logging-middleware/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}